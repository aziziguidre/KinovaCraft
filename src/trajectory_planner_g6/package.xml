<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>trajectory_planner_g6</name>
  <version>0.1.0</version>
  <description>Visualisation RViz2 pour Kinova Gen3 6-DOF sous simulation MATLAB / ROS 2.</description>
  <maintainer email="aziz@todo.todo">Aziz</maintainer>
  <author email="aziz@todo.todo">Aziz</author>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>xacro</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>kortex_description</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
